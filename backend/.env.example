# === Backend Environment Variables ===
# Copy this file to .env and fill in real values. Never commit .env to git.

# Groq API Key — get yours at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Allowed frontend origin(s) for CORS — comma-separated
# Local dev: http://localhost:5173
# Production: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: override the default Groq model
GROQ_MODEL=openai/gpt-oss-20b

# Port the API will listen on (Render sets this automatically)
PORT=8000
